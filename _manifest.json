{
  "manifest_version": 2,
  "id": "maibot.fun-pack",
  "version": "1.6.3",
  "name": "麦麦小工具合集",
  "description": "麦爹的娱乐功能合集：喜报/悲报图片生成、锦旗图片生成、一言（不计入消息）、答案之书（<问题> 翻看答案）、今天吃什么（命令 + 被动触发）、群早晚安作息记录、今日宜忌（每日黄历，同一天全群同结果）、群友语录（/投稿语录 + /群友语录，玩法参考 pan-ice plugins-uumessage）；每个功能都有独立开关；同时注册为麦麦可自主调用的 LLM 工具。",
  "author": {
    "name": "NetaJuutilainen",
    "url": "https://github.com/NetaJuutilainen"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NetaJuutilainen/Maibot_fun_pack_plugin"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.hybrid",
    "maisaka.context.append",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_by_id"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "background": "#A91C13"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "game",
  "changelog": "CHANGELOG.md"
}
