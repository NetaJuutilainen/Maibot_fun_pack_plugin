{
  "manifest_version": 2,
  "id": "maibot.fun-pack",
  "version": "1.3.3",
  "name": "麦麦小工具合集",
  "description": "麦爹的娱乐功能合集：喜报/悲报图片生成、一言（不计入消息）、答案之书（<问题> 翻看答案）、今天吃什么（命令 + 被动触发：概率推荐/复读/防循环限流）、群早晚安作息记录、指令菜单；同时注册为麦麦可自主调用的 LLM 工具。",
  "author": { "name": "NetaJuutilainen", "url": "https://github.com/NetaJuutilainen" },
  "license": "MIT",
  "urls": { "repository": "https://github.com/NetaJuutilainen/Maibot_fun_pack_plugin" },
  "host_application": { "min_version": "1.0.0", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.5.0", "max_version": "2.99.99" },
  "dependencies": [
    { "type": "python_package", "name": "aiohttp", "version_spec": ">=3.8.0" },
    { "type": "python_package", "name": "Pillow", "version_spec": ">=10.0.0" }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.hybrid",
    "maisaka.context.append",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "background": "#A91C13"
    }
  },
  "i18n": { "default_locale": "zh-CN" },
  "plugin_type": "game"
}
